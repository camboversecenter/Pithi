# ---------------------------------------------------------------------------
# PITHI environment configuration
#
# Copy this file to `.env.local` and fill in the values for your own Supabase
# project. `.env.local` is git-ignored — never commit real values.
#
# Everything prefixed with VITE_ is inlined into the client bundle and is
# therefore PUBLIC. Only ever put publishable values here; secrets (such as the
# Gemini API key or the Supabase service-role key) belong in Edge Function
# secrets, never in this file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
# Found under Project Settings > Data API in the Supabase dashboard.
VITE_SUPABASE_URL=

# Supabase anon/publishable key. Safe to expose in the browser as long as
# Row-Level Security is enabled on every table (see supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=

# Optional. Google account that is auto-provisioned as the super administrator
# on first sign-in and cannot be removed from the admin list. Leave blank to
# disable auto-promotion and manage admins from the Admin dashboard instead.
#
# If you set this, apply the same address in the database so the server-side
# checks agree:
#   select public.set_super_admin_email('you@example.com');
# See supabase/migrations/006_configurable_super_admin.sql.
VITE_SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Not set here — configured server-side:
#
#   GEMINI_API_KEY   Secret for the `gemini-proxy` Supabase Edge Function.
#                    Set it with:
#                      supabase secrets set GEMINI_API_KEY=your-key
#                    It must never be exposed to the browser.
# ---------------------------------------------------------------------------
